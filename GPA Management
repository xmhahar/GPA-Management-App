import tkinter as tk
from tkinter import ttk, messagebox

def calculate_gpa(total_score):
    max_score = 800

    gpa = (total_score / max_score) * 4

    return round(gpa, 2)

def add_student():
    name = entry_name.get()

    try:
        rla = float(entry_rla.get())
        science = float(entry_sc.get())
        math = float(entry_math.get())
        social = float(entry_ss.get())

    except ValueError:
        messagebox.showerror("Error", "Please enter valid numbers!")
        return

    # Total score
    total = rla + science + math + social

    # GPA
    gpa = calculate_gpa(total)

    # Insert into table
    tree.insert(
        "",
        tk.END,
        values=(name, rla, science, math, social, total, gpa)
    )

    clear_fields()


def clear_fields():
    entry_name.delete(0, tk.END)
    entry_rla.delete(0, tk.END)
    entry_sc.delete(0, tk.END)
    entry_math.delete(0, tk.END)
    entry_ss.delete(0, tk.END)

def delete_student():
    selected = tree.selection()

    if not selected:
        messagebox.showwarning("Warning", "Select a student!")
        return

    for item in selected:
        tree.delete(item)

def on_enter(e):
    e.widget['background'] = '#45a049'

def on_leave(e):
    e.widget['background'] = '#4CAF50'

root = tk.Tk()
root.title("🎓 GED GPA Management System")
root.geometry("900x600")
root.configure(bg="#e3f2fd")

title = tk.Label(
    root,
    text="GED GPA Management System",
    font=("Segoe UI", 22, "bold"),
    bg="#e3f2fd",
    fg="#0d47a1"
)

title.pack(pady=15)

card = tk.Frame(root, bg="white")
card.pack(padx=20, pady=10, fill="x")

# Student Name
tk.Label(
    card,
    text="Student Name",
    bg="white",
    font=("Segoe UI", 10)
).grid(row=0, column=0, padx=10, pady=10)

entry_name = tk.Entry(card, width=25)
entry_name.grid(row=0, column=1)

# RLA
tk.Label(
    card,
    text="RLA",
    bg="white",
    font=("Segoe UI", 10)
).grid(row=1, column=0, padx=10, pady=10)

entry_rla = tk.Entry(card, width=15)
entry_rla.grid(row=1, column=1)

# Science
tk.Label(
    card,
    text="Science",
    bg="white",
    font=("Segoe UI", 10)
).grid(row=2, column=0, padx=10, pady=10)

entry_sc = tk.Entry(card, width=15)
entry_sc.grid(row=2, column=1)

# Mathematics
tk.Label(
    card,
    text="Mathematics",
    bg="white",
    font=("Segoe UI", 10)
).grid(row=3, column=0, padx=10, pady=10)

entry_math = tk.Entry(card, width=15)
entry_math.grid(row=3, column=1)

# Social Studies
tk.Label(
    card,
    text="Social Studies",
    bg="white",
    font=("Segoe UI", 10)
).grid(row=4, column=0, padx=10, pady=10)

entry_ss = tk.Entry(card, width=15)
entry_ss.grid(row=4, column=1)

btn_frame = tk.Frame(root, bg="#e3f2fd")
btn_frame.pack(pady=20)

# Add Button
btn_add = tk.Button(
    btn_frame,
    text="Add Student",
    bg="#4CAF50",
    fg="white",
    font=("Segoe UI", 10, "bold"),
    width=15,
    command=add_student
)

btn_add.grid(row=0, column=0, padx=10)

btn_add.bind("<Enter>", on_enter)
btn_add.bind("<Leave>", on_leave)

btn_clear = tk.Button(
    btn_frame,
    text="Clear",
    bg="#2196F3",
    fg="white",
    width=15,
    command=clear_fields
)
btn_clear.grid(row=0, column=1, padx=10)

btn_delete = tk.Button(
    btn_frame,
    text="Delete",
    bg="#f44336",
    fg="white",
    width=15,
    command=delete_student
)

btn_delete.grid(row=0, column=2, padx=10)

#  TABLE 
table_frame = tk.Frame(root)
table_frame.pack(padx=20, pady=10, fill="both", expand=True)

columns = (
    "Name",
    "RLA",
    "Science",
    "Math",
    "Social",
    "Total",
    "GPA"
)

style = ttk.Style()
style.theme_use("default")

style.configure(
    "Treeview",
    background="white",
    foreground="black",
    rowheight=30,
    fieldbackground="white",
    font=("Segoe UI", 10)
)

style.configure(
    "Treeview.Heading",
    font=("Segoe UI", 10, "bold")
)

style.map(
    "Treeview",
    background=[('selected', '#90caf9')]
)

tree = ttk.Treeview(
    table_frame,
    columns=columns,
    show="headings"
)

for col in columns:
    tree.heading(col, text=col)
    tree.column(col, anchor="center", width=100)

tree.pack(side="left", fill="both", expand=True)

scrollbar = ttk.Scrollbar(
    table_frame,
    orient="vertical",
    command=tree.yview
)

tree.configure(yscroll=scrollbar.set)

scrollbar.pack(side="right", fill="y")

root.mainloop()
